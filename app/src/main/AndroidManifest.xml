<?xml version="1.0" encoding="utf-8"?>
<!-- Modified 2026-11-17 (DFRoot GZIF): application label renamed to "DFRoot GZIF". See NOTICE. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="df.root">

    <!-- INTERNET is a normal permission (auto-granted at install, no user
         consent, no Play policy concern) and is REQUIRED by the exploit: the
         Java side opens a DatagramSocket() for the sender port and the native
         binary (launched as the app UID via ProcessBuilder) opens an
         AF_INET/SOCK_DGRAM socket for the IpSec/loopback UDP channel. Android
         checks INTERNET for every AF_INET socket create, loopback included, so
         without it both paths fail with EACCES and the exploit breaks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- QUERY_ALL_PACKAGES is a restricted permission on API 30+. We only need
         to resolve the two supported SU managers, so declare a narrow <queries>
         whitelist instead. PackageManager.getApplicationInfo()/getLabel()/getIcon()
         still see these explicitly declared packages under package visibility
         restrictions. Keep in sync with ExploitRunner.KSU_MANAGER_PACKAGES. -->
    <queries>
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
    </queries>

    <application
        android:label="DFRoot GZIF"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.DirtyFrag">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
