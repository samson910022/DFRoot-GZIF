<?xml version="1.0" encoding="utf-8"?>
<!-- Modified 2026-11-24 (DFRoot GZIF): document manual-only soft reboot and configuration status. See NOTICE. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="configuration_status"
        android:title="Configuration"
        android:selectable="false" />

    <Preference
        android:key="configuration_retry"
        android:title="Retry configuration load" />

    <!-- Unavailable at code level: hard-disabled in every state; the separate
         boot_disable row below is the only (safe OFF) component action. -->
    <SwitchPreference
        android:key="boot_start"
        android:title="Start at Boot"
        android:summary="Unavailable - disabled in this build"
        android:enabled="false"
        android:selectable="false" />

    <!-- Round-6: persistent, non-selectable status row. Its summary is rewritten
         from every fresh observation; "Status unavailable" is the honest default. -->
    <Preference
        android:key="boot_status"
        android:title="Start at Boot status"
        android:summary="Status unavailable"
        android:selectable="false" />

    <!-- Explicit, always-available safe OFF action. Never enables anything. -->
    <Preference
        android:key="boot_disable"
        android:title="Disable automatic startup"
        android:summary="Explicitly turn automatic startup OFF. Safe to use even when status cannot be read; nothing is ever turned ON by this action." />

    <!-- Unavailable at code level: no consent dialog and no enable write exist. -->
    <SwitchPreference
        android:key="soft_reboot"
        android:title="Auto Soft Reboot"
        android:summary="Unavailable - experimental soft reboot is disabled in this build"
        android:defaultValue="false"
        android:enabled="false"
        android:selectable="false" />

    <SwitchPreference
        android:key="disable_modules"
        android:title="Disable KSU Modules"
        android:summary="Turn this on if a broken module is crashing your device. The next run will launch with all modules disabled."
        android:defaultValue="false" />

</PreferenceScreen>
